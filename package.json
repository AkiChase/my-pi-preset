{
  "name": "my-pi-preset",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "My personal pi preset: packages manifest, sync script and extensions",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "extensions/*.ts"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "link-sdk": "node scripts/link-pi-sdk.mjs",
    "typecheck": "node scripts/link-pi-sdk.mjs && tsc -p tsconfig.json",
    "test": "node scripts/link-pi-sdk.mjs && node --test --test-force-exit \"extensions/**/__tests__/*.test.ts\" \"extensions/**/__tests__/*.test.mjs\" \"scripts/*.test.mjs\"",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@shikijs/cli": "^4.0.2",
    "shiki": "^4.0.2",
    "croner": "^10.0.1",
    "nanoid": "^5.1.16"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "typebox": "^1.3.27"
  }
}
