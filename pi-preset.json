{
  "packages": {
    "git:github.com/AkiChase/my-pi-preset": "latest",
    "npm:pi-cache-optimizer": "latest",
    "npm:pi-input-history": "latest",
    "npm:pi-web-access": "latest",
    "npm:@juicesharp/rpiv-ask-user-question": "latest"
  },
  "conflicts": [
    "npm:pi-patty-bg-tasks",
    "npm:@heyhuynhgiabuu/pi-pretty",
    "npm:@tintinweb/pi-subagents",
